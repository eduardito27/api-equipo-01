{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "api-equipo-01",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": { "AMBIENTE": "produccion" },
  "env": {
    "staging": {
      "observability": { "enabled": true },
      "vars": { "AMBIENTE": "staging" }
    }
  }
}
